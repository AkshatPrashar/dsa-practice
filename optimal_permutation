#include<bits/stdc++.h>
using namespace std;

void optimal_permutation(int index,vector<int>& arr,vector<vector<int>>& ans){

    if(index==arr.size()){
        ans.push_back(arr);
        return;
    }

    for(int i=index;i<arr.size();i++){

        swap(arr[i],arr[index]);

        optimal_permutation(index+1,arr,ans);

        swap(arr[i],arr[index]);

    }

}

int main(){

    vector<int> arr={3,4,5};

    vector<vector<int>> ans;

    optimal_permutation(0,arr,ans);

    for(int i=0;i<ans.size();i++){

        for(int j=0;j<ans[i].size();j++){

            cout<<ans[i][j]<<" ";

        }

        cout<<"\n";
    }


}
