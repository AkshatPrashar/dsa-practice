#include<bits/stdc++.h>
using namespace std;

int mode(vector<int>& arr,int n){

    int max=0,el=-1,cnt=0;
    int i=0,j=0;

    while(j<n){

        if(arr[j]==arr[i]){

            cnt++;
            if(cnt>max){

                el=arr[j];
                max=cnt;

            }
            j++;

        }
        else{

            i=j;
            cnt=0;

        }

    }

    return el;

}

int main(){

    vector<int> arr={1,1,3,4,4,4,5,5,5,5};
    int ans=mode(arr,arr.size());

    cout<<"ans: "<<ans;

}
