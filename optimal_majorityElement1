#include<bits/stdc++.h>
using namespace std;

int optimal_maj(vector<int> arr){

    int count=0;
    int el;
    for(int i=0;i<arr.size();i++){

        if(count==0){
            el=arr[i];
            count++;
        }
        else if(el==arr[i]){
            count++;
        }
        else{
            count--;
        }

    }

    count=0;
    for(int i=0;i<arr.size();i++){

        if(arr[i]==el) count++;
        if(count>(arr.size()/2)) return el;

    }

    return -1;

}

int main(){

    vector<int> arr={2,2,2,2,1,1,1};
    int maj=optimal_maj(arr);
    cout<<"Majiorty element= "<<maj;

}
